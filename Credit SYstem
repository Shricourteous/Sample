from pydantic import BaseModel, Field
from datetime import datetime
from enum import Enum
from decimal import Decimal, ROUND_CEILING
import math


class ModelType(Enum):
    GPT_3_5_TURBO = "gpt-3.5-turbo"
    GPT_4_O       = "gpt-4o"
    O1_PREVIEW    = "o1-preview"

# Model Rates (credits per token)

# 4o
# | Type   | Rate   | Tokens per 1 credit |
# | ------ | ------ | ------------------- |
# | Input  | 0.0025 | **400 tokens**      |
# | Output | 0.0100 | **100 tokens**      |

# 4o mini
# | Type   | Rate (credits/token) | Tokens per 1 credit |
# | ------ | -------------------- | ------------------- |
# | Input  | 0.0010               | **1000 tokens**     |
# | Output | 0.0040               | **250 tokens**      |


MODEL_RATES = {
    ModelType.GPT_3_5_TURBO: {"in": Decimal("0.0005"), "out": Decimal("0.0015")},
    ModelType.GPT_4_O:       {"in": Decimal("0.0025"), "out": Decimal("0.0100")},
    ModelType.O1_PREVIEW:    {"in": Decimal("0.0150"), "out": Decimal("0.0600")},
}


class CostBreakdown(BaseModel):
    model: str
    input_tokens: int
    output_tokens: int
    input_credits: Decimal
    output_credits: Decimal
    total_credits: Decimal
    currency_value_usd: Decimal = Field(..., description="Conversion for accounting")
    timestamp: datetime = Field(default_factory=datetime.utcnow)

    class Config:
        # ensure Decimal serializes cleanly
        ser_json_timedelta = "iso8601"
        ser_json_bytes = "base64"
        json_encoders = {Decimal: lambda d: float(round(d, 6))}


class BillingEngine:
    # 1 Credit = $0.001 (1000 Credits = $1)
    def __init__(self, credit_value_usd=Decimal("0.001")):
        self.rates = MODEL_RATES
        self.credit_value_usd = Decimal(str(credit_value_usd))


    def calculate_bill(self, model: ModelType, input_tokens: int, output_tokens: int) -> CostBreakdown:
        rate = self._get_rate(model)

        input_credits = self._round_up(rate["in"] * input_tokens)
        output_credits = self._round_up(rate["out"] * output_tokens)

        total = self._round_up(input_credits + output_credits)

        return CostBreakdown(
            model=model.value,
            input_tokens=input_tokens,
            output_tokens=output_tokens,
            input_credits=input_credits,
            output_credits=output_credits,
            total_credits=total,
            currency_value_usd=self._round_up(total * self.credit_value_usd)
        )


    def estimate_from_text(self, model: ModelType, text: str) -> Decimal:
        est_in = len(text) // 3
        est_out = 5000 if (est_in // 3) < 5000 else est_in // 3 
        return self.calculate_bill(model, est_in, est_out).total_credits


    def _round_up(self, amount: Decimal) -> Decimal:
        return amount.quantize(Decimal("0.0001"), rounding=ROUND_CEILING)

    def _get_rate(self, model: ModelType):
        if model not in self.rates:
            raise ValueError(f"Unknown model type: {model}")
        return self.rates[model]

   


